# 7. Rain Sensor (Method 2)

import time
import RPi.GPIO as g

sensor = 37   # On board connect to P14

g.setmode(g.BOARD)
g.setup(sensor, g.IN)
g.setwarnings(False)

def call_back(sensor):
    if g.input(sensor):
        print("Raining")
    else:
        print("No rain")

g.add_event_detect(sensor, g.BOTH, bouncetime=300)
g.add_event_callback(sensor, call_back)

while True:
    time.sleep(2)
