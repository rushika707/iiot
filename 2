# 1. Interface Servo Motor with Single Cycle

import RPi.GPIO as g
import time

g.setmode(g.BOARD)
g.setwarnings(False)

g.setup(11, g.OUT)   # Connect to P15 on Raspberry Pi

servo = g.PWM(11, 50)
servo.start(5)

print("wait")
time.sleep(1)

duty = 2

while duty <= 17:
    servo.ChangeDutyCycle(duty)
    time.sleep(5)
    duty = duty + 2

print("turning back to 0 degrees")

servo.ChangeDutyCycle(2)
time.sleep(5)

servo.ChangeDutyCycle(0)
servo.stop()

g.cleanup()

print("cleared")
```

Output:

```text
Servo motor turns 180 degrees
```

