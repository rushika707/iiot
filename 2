# 7. Rain Sensor (Method 1)

import RPi.GPIO as g
import time

sensor = 37   # On board connect to P14

def setup():
    g.setmode(g.BOARD)
    g.setup(sensor, g.IN)

def loop():
    try:
        while True:
            if g.input(sensor) == 1:
                print("Rain detected")
            else:
                print("No rain")

            time.sleep(2)

    except KeyboardInterrupt:
        g.cleanup()

if __name__ == "__main__":
    setup()
    loop()
