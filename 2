# 6. DHT Sensor Through ThingSpeak

import Adafruit_DHT
import RPi.GPIO as g
import time
from urllib.request import urlopen

g.setmode(g.BOARD)
g.setwarnings(False)

write_api = ".................."   # Replace with ThingSpeak API key

base_url = "https://api.thingspeak.com/update?api_key={}".format(write_api)

sensor = Adafruit_DHT.DHT11

pin = 17   # Connect to P15 on Raspberry Pi

print("Temperature & Humidity monitoring in progress")

try:
    while True:
        humidity, temp = Adafruit_DHT.read_retry(sensor, pin)

        print("Humidity =", str(humidity))
        print("Temperature =", str(temp))

        thingSpeakHTTP = base_url + "&field1={:.2f}&field2={:.2f}".format(humidity, temp)

        print(thingSpeakHTTP)

        conn = urlopen(thingSpeakHTTP)

        time.sleep(3)

except KeyboardInterrupt:
    g.cleanup()
```

