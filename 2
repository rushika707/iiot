# 9. LDR Sensor with Relay Switch

import RPi.GPIO as GPIO
import time

light = 11                 # Board pin number for LDR
relay = [32, 36, 38, 40]  # Relay pins
led = 13                   # LED pin

def setup():
    GPIO.setmode(GPIO.BOARD)

    GPIO.setup(light, GPIO.IN)

    GPIO.setup(relay, GPIO.OUT)

    GPIO.setup(led, GPIO.OUT)

def read_light():
    while True:
        light_state = GPIO.input(light)

        if light_state == 0:
            print("Light Detected")

            GPIO.output(relay, 0)
            GPIO.output(led, 0)

        elif light_state == 1:
            print("Light Not Detected")

            GPIO.output(relay, 1)
            GPIO.output(led, 1)

        time.sleep(0.3)

def destroy():
    GPIO.cleanup()

if __name__ == '__main__':
    try:
        setup()
        read_light()

    except KeyboardInterrupt:
        destroy()

