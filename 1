        print("Temperature =", str(temp))

        time.sleep(0.5)

        lcd.cursor_pos = (0, 0)
        lcd.write_string(f"Temperature : {temp}")

        lcd.cursor_pos = (1, 0)
        lcd.write_string(f"Humidity : {h}")

        time.sleep(1)

